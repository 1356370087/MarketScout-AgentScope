# 可信团队 Worker 专用环境文件。复制到本地受保护文件后填写，不提交真实凭据。
# 数据库接口使用 Compose 内网服务名，默认端口 5432；必须与 API 的身份和恢复库一致。
APP_ENV=production
LOCAL_DEV_AUTH_BYPASS=false
IAM_DATABASE_URL=postgresql+asyncpg://insightforge:REPLACE_ME@app-db:5432/insightforge
AS_DATABASE_URL=postgresql+asyncpg://insightforge:REPLACE_ME@app-db:5432/insightforge
AS_DATABASE_SCHEMA=agentscope_runtime
AS_STORAGE_AUTO_CREATE=false
COORDINATION_DATABASE_URL=postgresql://insightforge:REPLACE_ME@app-db:5432/insightforge
# 远程 RocketMQ gRPC Proxy 地址；9876 是 NameServer 端口，不可填在此处。
AS_ROCKETMQ_ENDPOINT=REPLACE_WITH_PROXY_HOST:PORT
AS_ROCKETMQ_GROUP=insightforge-native-worker
AS_ROCKETMQ_TOPIC_PREFIX=insightforge_as
AS_ROCKETMQ_TLS=false
# 私有检索在可信 Worker 执行；数据库中的运行绑定限制资料代次与所有者。
DOCUMENT_RESEARCH_ENABLED=true
DOCUMENT_DATABASE_URL=postgresql://insightforge:REPLACE_ME@app-db:5432/insightforge
DOCUMENT_STORAGE_DIR=/data/documents
RUNS_DIR=/data/runs
# 只填写控制面签名密钥，不注入 LiteLLM 管理密钥或模型提供商 API Key。
SANDBOX_ROOT_SIGNING_KEY=REPLACE_WITH_SHARED_BASE64_KEY
SANDBOX_GATEWAY_URL=http://sandbox-gateway:8081
SANDBOX_POLICY_PATH=/app/config/sandbox-policy.toml
