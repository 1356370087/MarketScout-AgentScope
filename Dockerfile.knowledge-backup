FROM postgres:17-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-asyncpg restic ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY src/open_deep_research/knowledge/backup.py /app/backup.py
ENTRYPOINT ["python3", "/app/backup.py"]
CMD ["loop"]
