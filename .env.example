# 本文件仅提供本地开发与部署配置示例，请复制为 .env 后再填写真实值。
# 不要提交包含 API Key、访问令牌、Cookie 或其他凭据的实际 .env 文件。
# 布尔值统一使用 true 或 false。
# MODEL_BACKEND=litellm 时，模型名称必须填写 config/litellm.yaml 中的逻辑别名，
# 例如 if-research-v1；只有 Legacy 兼容模式才使用“提供商:模型名”格式。

# 日志格式：console（本地友好）或 json（生产采集）。
LOG_FORMAT=console

# 沙箱默认关闭。启用后必须同时开启异步研究，并部署 Controller/Gateway。
SANDBOX_ENABLED=false
SANDBOX_POLICY_PATH=config/sandbox-policy.toml
SANDBOX_CONTROLLER_SOCKET=/run/insightforge/sandbox-controller.sock
SANDBOX_GATEWAY_URL=http://sandbox-gateway:8081
# 至少 32 字节随机值的 Base64；API、Controller 与 Gateway 必须一致。
# SANDBOX_ROOT_SIGNING_KEY=
# 仅 development/test 的确定性 CI Provider；生产环境强制拒绝 true。
SANDBOX_GATEWAY_FAKE_PROVIDER=false
# Compose 同时启动三服务时允许依赖就绪的等待窗口；窗口结束仍 fail-closed。
SANDBOX_STARTUP_GRACE_SECONDS=30

# 出网审批 auto 模式（仿 Claude Code auto mode）：unknown_target=auto 时，
# 未知域名先经模型分类器裁决（allow 免审批 / ask 转人工 / deny 拒绝），
# 分类器任何故障都 fail-safe 回人工审批。三档宽度 deny < manual < auto < open，
# run 级设置与运行时切换只能收窄、不能突破 TOML 基线。
# run 级模式：profile（跟随基线）/ manual / auto / open。
SANDBOX_EGRESS_APPROVAL_MODE=profile
# 分类器模型（provider:model）；未配置时回退 QUALITY_EVALUATION_MODEL。
# EGRESS_CLASSIFIER_MODEL=
# 分类器流水线：both（快筛+深度复核，默认）/ fast / thinking。
EGRESS_CLASSIFIER_STAGES=both
# 单目标两阶段合计超时（秒）；超时即回人工审批。
EGRESS_CLASSIFIER_TIMEOUT_SECONDS=30
# 每 run 分类器模型调用预算；耗尽后回人工审批。
EGRESS_CLASSIFIER_MAX_CALLS_PER_RUN=200
# 连续失败多少次后本 run 剩余时间退化为 manual。
EGRESS_CLASSIFIER_MAX_CONSECUTIVE_FAILURES=5
# 分类器角色级 API Key 覆盖（可选）。
# EGRESS_CLASSIFIER_API_KEY=
# 预置 egress 白名单（逗号分隔，支持 *.gov.cn / **.edu.cn 通配）：
# 命中即直接放行、不进分类器也不发人工审批。主要用于 E2E 预热常用研究域名，
# 避免人工 allow_once 延迟吃掉任务研究窗口；合并结果会计入冻结的 run 策略摘要。
# SANDBOX_EGRESS_ALLOW_DOMAINS=www.gov.cn,www.epa.gov,www.iea.org
# egress 审批等待：首次请求立即返回 approval_required（该轮不计入 react 预算），
# 重试附着到 pending 审批时最多阻塞该窗口等待人工决定，之后再次返回 pending。
SANDBOX_EGRESS_PENDING_WAIT_SECONDS=240
# 审批等待轮的物理轮次余量（这些轮会从有效 react 预算中退还）。
APPROVAL_PENDING_TURN_ALLOWANCE=20

# =============================================================================
# 一、LiteLLM 上游模型凭据
# =============================================================================

# 以下凭据由 LiteLLM Proxy根据 config/litellm.yaml 中实际启用的部署读取。
# 只填写正在使用的 Provider。不要把 Provider Key写入前端配置、Run 配置或 Sandbox。

# OpenAI API Key；config/litellm.yaml 启用 openai/* 部署时填写。
OPENAI_API_KEY=

# 可选的 OpenAI 兼容接口地址。官方 OpenAI 留空；自托管或代理端点按 YAML 示例启用 api_base。
OPENAI_BASE_URL=

# 阿里云百炼 DashScope API Key；YAML 启用 DashScope/Qwen 部署时填写。
DASHSCOPE_API_KEY=

# DeepSeek API Key；YAML 启用 deepseek/* 部署时填写。
DEEPSEEK_API_KEY=

# DeepSeek 兼容接口地址；使用 LiteLLM 原生 deepseek/* 路由时通常无需修改。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic API Key；YAML 启用 anthropic/* 部署或使用 Anthropic 原生搜索时填写。
ANTHROPIC_API_KEY=

# Google API Key；YAML 启用 Gemini 部署时填写。
GOOGLE_API_KEY=

# =============================================================================
# 二、应用逻辑模型别名
# =============================================================================

# 对搜索结果、网页内容和长对话进行摘要的模型。
SUMMARIZATION_MODEL=if-summarization-v1

# Supervisor 规划和研究调度模型；留空时继承 RESEARCH_MODEL。
SUPERVISOR_MODEL=if-supervisor-v1

# 执行 Subagent 推理、工具规划和研究循环的主模型。
RESEARCH_MODEL=if-research-v1

# 长对话自动摘要模型。
MESSAGE_SUMMARY_MODEL=if-message-summary-v1

# 将 Subagent 原始研究结果压缩为结构化交接内容的模型。
COMPRESSION_MODEL=if-compression-v1

# 汇总全部研究证据并生成最终报告的模型。
FINAL_REPORT_MODEL=if-final-report-v1

# 摘要模型单次响应的最大输出 Token 数。
SUMMARIZATION_MODEL_MAX_TOKENS=8192

# 研究模型单次响应的最大输出 Token 数。
RESEARCH_MODEL_MAX_TOKENS=10000

# 压缩模型单次响应的最大输出 Token 数。
COMPRESSION_MODEL_MAX_TOKENS=10000

# 最终报告模型单次响应的最大输出 Token 数。
FINAL_REPORT_MODEL_MAX_TOKENS=10000

# =============================================================================
# 三、研究流程与 Agent 调度
# =============================================================================

# 搜索服务类型；可选值为 tavily、openai、anthropic、none。
SEARCH_API=tavily

# 是否允许系统在研究开始前向用户提出一次澄清问题。
ALLOW_CLARIFICATION=true

# 同一轮 Supervisor 最多并行运行的 Researcher 数量。
MAX_CONCURRENT_RESEARCH_UNITS=5

# Supervisor 最多执行的研究调度轮数。
MAX_RESEARCHER_ITERATIONS=6

# 单个 Researcher 最多执行的工具循环次数。
MAX_REACT_TOOL_CALLS=10

# 单次研究工具调用的超时时间，单位为秒。
RESEARCH_TOOL_CALL_TIMEOUT_SECONDS=300

# 模型传输重试、请求超时、fallback 和 cooldown 统一在 config/litellm.yaml 配置。
# LiteLLM 主路径不要配置 MODEL_FALLBACKS、MODEL_TRANSPORT_MAX_ATTEMPTS 或 Circuit 参数。

# =============================================================================
# 四、搜索服务与结构化证据流水线
# =============================================================================

# Tavily API Key；SEARCH_API=tavily 时必须填写。
TAVILY_API_KEY=

# Firecrawl API Key；启用对应网页抓取能力时填写。
FIRECRAWL_API_KEY=

# Web 流水线模式；legacy 使用旧流程，shadow 仅旁路评估，enforced 强制执行结构化证据流程。
WEB_PIPELINE_MODE=enforced

# shadow 模式下进入旁路评估的请求比例，取值范围为 0 到 1。
WEB_PIPELINE_SHADOW_SAMPLE_RATE=0.1

# 搜索候选中实际进入抓取阶段的 Top-K 数量。
FETCH_TOP_K=5

# 来源权威度最低阈值，取值范围为 0 到 1。
WEB_MIN_SOURCE_AUTHORITY=0.65

# 搜索候选来源重排模型；LiteLLM 模式填写逻辑模型别名。
WEB_RERANK_MODEL=if-web-rerank-v1

# 网页内容证据抽取模型；LiteLLM 模式填写逻辑模型别名。
WEB_EVIDENCE_MODEL=if-web-evidence-v1

# 每次搜索允许进入重排阶段的最大候选来源数。
SEARCH_CANDIDATE_LIMIT=20

# 单个 Researcher 允许执行的最大网页抓取次数。
MAX_FETCHES_PER_RESEARCHER=12

# 单次完整研究运行允许执行的最大网页抓取次数。
MAX_FETCHES_PER_RUN=40

# 从首波任务（wave-0）的运行级抓取池中预留的份额，供后续波次（补证任务）
# 使用。留空自动取 min(MAX_FETCHES_PER_RESEARCHER, MAX_FETCHES_PER_RUN / 5)；
# 设为 0 关闭预留。注意首波任务数 × 单任务上限超过运行池时，没有预留会让
# 补证任务从第一个迭代起就拿不到任何抓取配额。
# FETCH_BUDGET_FOLLOWUP_RESERVE=8

# 全局同时执行网页抓取的最大并发数。
FETCH_GLOBAL_CONCURRENCY=4

# 同一域名同时执行网页抓取的最大并发数。
FETCH_PER_HOST_CONCURRENCY=2

# 单个 HTML 文档允许读取的最大字节数，示例值为 2 MiB。
HTML_MAX_BYTES=2097152

# 单个 PDF 文档允许读取的最大字节数，示例值为 20 MiB。
PDF_MAX_BYTES=20971520

# 单个 PDF 文档允许处理的最大页数。
PDF_MAX_PAGES=100

# 是否遵守目标网站的 robots.txt 规则。
RESPECT_ROBOTS_TXT=true

# 普通 HTTP 抓取失败时是否允许使用浏览器渲染作为降级方案。
BROWSER_RENDER_FALLBACK_ENABLED=true

# =============================================================================
# 五、质量门禁与研究交接评估
# =============================================================================

# 是否启用研究证据、Subagent 交接和最终报告质量评估。
QUALITY_EVALUATION_ENABLED=false

# 质量评估模型逻辑别名；建议与研究主模型分离，避免同源偏差。
QUALITY_EVALUATION_MODEL=if-quality-v1

# 质量评估模型单次响应的最大输出 Token 数；自托管大模型建议 8192。
QUALITY_EVALUATION_MODEL_MAX_TOKENS=8192

# 质量评估模型采样温度，取值范围 0 到 2；取值越低评估输出越稳定。
# 删除或注释该行时使用服务提供商默认温度。
QUALITY_EVALUATION_TEMPERATURE=0.1

# 质量评估异常时是否放行研究流程；true 表示评估器故障不阻断研究。
QUALITY_EVALUATION_FAIL_OPEN=true

# 质量评估严格度；可选值为 permissive、balanced、strict。
QUALITY_EVALUATION_RIGOR=balanced

# 质量门禁要求的最少独立来源数量。
QUALITY_EVALUATION_MIN_SOURCES=2

# 是否在最终报告写作后运行成品 Reviewer → Revisor 闭环；默认关闭以保持旧行为。
REPORT_REVIEW_ENABLED=false

# 分章节报告的写作并发数（单位：模型调用）；默认 2，范围 1–6。
# 同时控制引言和结论的并发；仅作用于分章节报告，填 1 可串行执行。
REPORT_SECTION_CONCURRENCY=2

# 最终报告 Reviewer 模型逻辑别名；留空时复用 QUALITY_EVALUATION_MODEL。
# REPORT_REVIEW_MODEL=if-report-review-v1

# Reviewer 单次结构化输出 Token 上限；Revisor 继续使用 FINAL_REPORT_MODEL_MAX_TOKENS。
REPORT_REVIEW_MODEL_MAX_TOKENS=3072

# 可选 Reviewer 采样温度（0 到 2）；留空使用 Provider 默认值。
# REPORT_REVIEW_TEMPERATURE=0.1

# Reviewer 输入字符预算。
REPORT_REVIEW_MAX_INPUT_CHARS=40000

# 最多执行的 Revisor 修订轮数（0 到 3）。
REPORT_REVIEW_MAX_REVISIONS=1

# Reviewer 服务不可用时是否交付带 degraded 标记的草稿。
REPORT_REVIEW_FAIL_OPEN=true

# Reviewer 角色级 API Key 覆盖（可选）。
# REPORT_REVIEW_API_KEY=

# =============================================================================
# 六、离线评测与基准测试模型
# =============================================================================

# 离线评测模型逻辑别名。离线评测使用受限 Service Key，不使用 Master Key。
EVALUATION_MODEL=if-evaluation-v1

# 离线评测模型单次响应的最大输出 Token 数。
EVALUATION_MODEL_MAX_TOKENS=8192

# 单次离线评测允许输入的最大证据字符数。
EVALUATION_EVIDENCE_MAX_CHARS=120000

# =============================================================================
# 七、认证、前端接入与部署
# =============================================================================

# 允许访问 FastAPI 的前端来源，多个地址使用英文逗号分隔。
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LiteLLM 主路径不从 Run configurable 读取 Provider API Key。

# =============================================================================
# 八、长期记忆
# =============================================================================

# 是否启用长期记忆功能。
ENABLE_MEMORY=false

# Mem0 存储提供方式；platform 表示托管平台，其他模式需与项目实现保持一致。
MEM0_PROVIDER=platform

# OSS 模式的 Mem0 配置文件路径（JSON）；platform 模式忽略。
# embedder 可指向 LiteLLM 网关的嵌入模型别名（如 if-embedding-v1），
# 统一密钥/预算/追踪，示例见 config/litellm.yaml 嵌入模板。
# MEM0_CONFIG_PATH=

# Mem0 API Key；启用托管长期记忆时填写。
MEM0_API_KEY=

# 长期记忆应用标识，用于隔离不同应用的数据。
MEMORY_APP_ID=open_deep_research

# Mem0 记忆项目标识；使用托管项目时填写。
MEM0_MEMORY_PROJECT_ID=

# 写入长期记忆时使用的 Agent 标识。
MEMORY_AGENT_ID=lead_researcher

# 是否启用高级记忆 schema-v2；默认关闭以保持兼容。
MEMORY_ADVANCED_ENABLED=false

# Mem0 Platform 项目级 decay 的期望状态；仅由显式 maintenance configure-decay 命令应用。
MEMORY_DECAY_ENABLED=true

# schema-v2 启用时是否继续召回不可变更的 legacy 记忆；默认关闭，避免旧偏好与新偏好并列注入。
MEMORY_LEGACY_RECALL_ENABLED=false

# 是否在每次 run 结束后异步调度完整维护；默认关闭，推荐使用 daily CLI/系统定时器。
MEMORY_RUN_END_MAINTENANCE_ENABLED=false

# 同一用户并发写记忆时的最长等待秒数；超时后记忆写入仍按 advisory fail-open 跳过。
MEMORY_MUTATION_LOCK_TIMEOUT_SECONDS=5

# 是否生成并保存研究反思记忆。
MEMORY_REFLECTION_ENABLED=true

# reflection/profile/conflict 提示词的最大输入字符预算。
MEMORY_MAINTENANCE_MAX_INPUT_CHARS=30000

# 是否维护用户或领域画像记忆。
MEMORY_PROFILE_ENABLED=true

# 是否启用软遗忘，降低旧记忆权重而不是直接删除。
MEMORY_SOFT_FORGETTING_ENABLED=true

# 是否保存通过验证的研究洞见。
MEMORY_VERIFIED_INSIGHTS_ENABLED=true

# 可选的 JSON 半衰期覆盖配置，单位为天；取消下一行注释后生效。
# MEMORY_HALF_LIFE_DAYS={"user_research_preference":180,"domain_profile":180,"project_memory":90,"verified_research_insight":30,"reflection":90}

# =============================================================================
# 九、可观测性与指标
# =============================================================================

# 是否启用独立于 Trace/Langfuse/Prometheus 的最小 Token 核算持久化。
TOKEN_USAGE_ACCOUNTING_ENABLED=true

# Provider 成功响应未返回 usage 时，是否启用输入/输出 Token 估算补位。
TOKEN_USAGE_ESTIMATION_ENABLED=true

# 是否启用 Langfuse Trace 上报。
# 原生 AgentScope 使用内容最小化的 Middleware 与 OTLP/HTTP 导出，无需 LangChain callback。
# 启用时须同时填写公钥、私钥和服务地址；默认关闭。团队 Worker 使用自己的受信环境配置。
LANGFUSE_ENABLED=false

# Langfuse 公钥。
LANGFUSE_PUBLIC_KEY=

# Langfuse 私钥；不得提交到版本库或暴露给浏览器。
LANGFUSE_SECRET_KEY=

# Langfuse 服务地址，可替换为自托管地址。
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Langfuse 环境名称，用于区分开发、测试和生产数据。
LANGFUSE_ENVIRONMENT=development

# 是否通过 OTLP/HTTP 导出不含正文的应用 Trace。
# 该通道不会附加提示词、响应正文或消息预览。
OTEL_ENABLED=false
OTEL_SERVICE_NAME=insightforge-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# 是否启用 LangSmith Trace；启用后还需配置 LANGSMITH_API_KEY。
LANGSMITH_ENABLED=false

# LangSmith 接口密钥。
LANGSMITH_API_KEY=

# 是否启用 Prometheus 指标端点。
PROMETHEUS_ENABLED=false

# Prometheus 指标暴露路径。
PROMETHEUS_METRICS_PATH=/metrics

# 可观测性 compose profile（docker compose --profile observability up）的
# 端口与开关。开启网关侧 trace 还需设置：
#   LITELLM_CONFIG_PATH=/app/config/litellm.otel.yaml
#   LITELLM_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# 应用侧 trace 设置 OTEL_ENABLED=true 与
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# 详见 deploy/README.md。注意：LiteLLM 的 /metrics 无鉴权，生产环境建议
# 移除 litellm-proxy 的宿主机端口映射。
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
OTEL_COLLECTOR_HOST_PORT=4318
JAEGER_HOST_PORT=16686

# =============================================================================
# 十、异步研究、检查点与文件邮箱
# =============================================================================

# 是否启用异步研究任务模式。
ENABLE_ASYNC_RESEARCH=false

# 异步研究模式：collaborator 为 Lead 委派（默认）；teams 为 Lead 建队、成员派发与自主认领。
# 仅 ENABLE_ASYNC_RESEARCH=true 时生效；创建运行时冻结，恢复不会随环境配置切换。
ASYNC_RESEARCH_MODE=collaborator
# 团队默认执行方式：direct 直接执行（默认）；plan_approval 先规划并由 Lead 审核。
# 仅 teams 模式生效，Lead 启动成员时可单独覆盖；不替代用户的工具和出网审批。
TEAM_EXECUTION_MODE=direct

# 运行数据保存目录，包含 manifest、公开事件和任务活动日志。
RUNS_DIR=.runs

# =============================================================================
# 报告发布 Worker（PDF / DOCX / PPTX / JSON / One Pager）
# =============================================================================

# API 是否接受异步发布任务。独立 Worker 必须共享同一个 RUNS_DIR。
PUBLISHER_ENABLED=true
PUBLISHER_POLL_INTERVAL_SECONDS=1
PUBLISHER_LEASE_SECONDS=180
PUBLISHER_MAX_CONCURRENT_JOBS=2
PUBLISHER_MAX_ATTEMPTS=3
PUBLISHER_MAX_INPUT_CHARS=500000
PUBLISHER_MAX_OUTPUT_BYTES=52428800
PUBLISHER_MAX_PDF_PAGES=100
PUBLISHER_MAX_PPTX_SLIDES=64
PUBLISHER_SSE_IDLE_SECONDS=60
PUBLISHER_HEARTBEAT_INTERVAL_SECONDS=10
PUBLISHER_HEARTBEAT_STALE_SECONDS=45

# `.runs` 目录的建议容量上限，供 Prometheus 容量告警使用；0 表示不限制。
RUNS_DIR_MAX_BYTES=0

# 终态运行目录的保留清扫周期（秒）；0 关闭自动清扫。
RETENTION_SWEEP_INTERVAL_SECONDS=3600

# 终态运行目录保留天数；0 永久保留。
RUN_RETENTION_DAYS=30

# Trace SQLite 保留天数；未设置时跟随 RUN_RETENTION_DAYS。
# TRACE_RETENTION_DAYS=30

# 每个登录主体每分钟最多创建的 run 数；0 关闭。
API_RUN_CREATE_PER_MINUTE=10

# 每个登录主体在本进程内最多并发运行数；0 关闭。
MAX_CONCURRENT_RUNS_PER_USER=3

# 本进程允许的 SSE 并发连接总数；0 关闭。
MAX_CONCURRENT_SSE_CONNECTIONS=50

# API 请求体上限（字节），默认 2 MiB。
MAX_REQUEST_BODY_BYTES=2097152

# 终态 run 在进程内继续保留的秒数；完整事件始终从磁盘事件流回放。
INFLIGHT_RUN_MEMORY_RETENTION_SECONDS=600

# 进程内 RunRecord 数量软上限；超限时优先淘汰最早结束的终态 run。
MAX_INFLIGHT_RUNS_IN_MEMORY=100

# 每个进程内 run 保留的最近事件数；磁盘 public_events.jsonl 不受此限制。
INFLIGHT_EVENT_BUFFER_SIZE=200

# 优雅停机时将运行中任务落为 interrupted 并取消任务的总预算（秒）。
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

# 启动时是否扫描非终态 manifest，并将租约已失效的孤儿 run 标记为 interrupted。
RUN_RECOVERY_SWEEP_ON_STARTUP=true

# 异步任务状态存储后端；当前推荐使用 file。
TASK_STATE_BACKEND=file

# 单个异步任务的最大运行时间，单位为秒。
TASK_TIMEOUT_SECONDS=900

# 单个运行允许同时处于执行中的最大异步任务数。
MAX_IN_FLIGHT_TASKS=20

# 是否为异步 Researcher 保存并恢复检查点。
TASK_CHECKPOINT_ENABLED=true

# 是否写入异步任务内部事件日志。
EVENT_LOG_ENABLED=true

# 可长期保持在线的 Teammate 最大数量。
MAX_PERSISTENT_TEAMMATES=5

# 文件邮箱轮询间隔，单位为毫秒。
MAILBOX_POLL_INTERVAL_MS=500

# 获取文件邮箱锁的最大等待时间，单位为秒。
MAILBOX_LOCK_TIMEOUT_SECONDS=5

# 邮箱消息认领租约时长，单位为秒。
MAILBOX_CLAIM_LEASE_SECONDS=30

# 单条邮箱消息允许的最大投递次数。
MAILBOX_MAX_DELIVERY_ATTEMPTS=5

# 已确认邮箱消息的保留时间，单位为秒。
MAILBOX_ACKED_RETENTION_SECONDS=86400

# 邮箱消息数量达到该阈值后触发压缩整理。
MAILBOX_COMPACTION_THRESHOLD=1000

# Leader 心跳发送间隔，单位为秒。
LEADER_HEARTBEAT_SECONDS=5

# Leader 租约有效期，单位为秒，通常应大于心跳间隔。
LEADER_LEASE_SECONDS=15

# ============================================================
# 自有身份与 RBAC 系统（IAM）配置
# 除显式本地开发旁路外，IAM_DATABASE_URL 为必填项。
# ============================================================

# 运行环境。production 下强制校验 JWT 密钥与 SMTP；development 下可自动生成临时 JWT 密钥。
APP_ENV=development

# IAM 数据库（asyncpg）。生产和常规本地开发均必须配置。
# IAM_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/odr_iam

# 本地开发认证旁路：仅在 APP_ENV=development 生效，返回合成的 researcher/developer 身份。
LOCAL_DEV_AUTH_BYPASS=false

# FastAPI 前方可信代理的跳数。代码默认 0（只信 socket 对端地址）；
# 值为 1 对应“仅经过本项目 nginx”一跳。若直接暴露 2024 端口必须保持 0，
# 否则客户端可伪造 X-Forwarded-For 轮换限流身份。
IAM_TRUSTED_PROXY_COUNT=1

# JWT 签发方。
IAM_JWT_ISSUER=open-deep-research

# Access / Refresh 各自独立的 Ed25519 密钥（PEM）。生产环境必须显式提供。
# 可用 python -c "from security.rbac.keys import generate_signing_keypair as g; print(*g(), sep='---')"
# 生成。当前签名私钥 + kid；IAM_JWT_*_VERIFY_KEYS 为可选的 {kid: 公钥} JSON，用于平滑轮换。
IAM_JWT_ACCESS_SIGNING_KEY=
IAM_JWT_ACCESS_KID=
IAM_JWT_ACCESS_VERIFY_KEYS=
IAM_JWT_REFRESH_SIGNING_KEY=
IAM_JWT_REFRESH_KID=
IAM_JWT_REFRESH_VERIFY_KEYS=

# 一次性邮箱令牌和 Refresh Token 摘要使用的独立 HMAC Secret；生产环境必填。
IAM_TOKEN_DIGEST_SECRET=

# 令牌与会话有效期（秒）。
IAM_ACCESS_TOKEN_TTL=900
IAM_REFRESH_IDLE_TTL=2592000
IAM_SESSION_ABSOLUTE_TTL=7776000
IAM_REFRESH_REUSE_GRACE=5
IAM_SSE_REAUTH_INTERVAL=60

# 一次性邮箱令牌有效期（秒）。
IAM_EMAIL_VERIFY_TTL=86400
IAM_PASSWORD_RESET_TTL=1800

# 邮件后端：console（开发，打印链接）或 smtp（生产）。
IAM_MAIL_BACKEND=console
IAM_SMTP_HOST=
IAM_SMTP_PORT=587
IAM_SMTP_STARTTLS=true
IAM_SMTP_USER=
IAM_SMTP_PASSWORD=
IAM_MAIL_FROM=no-reply@example.com
IAM_PUBLIC_BASE_URL=http://localhost:3000

# 是否开放注册。production 下开放注册必须配置 SMTP。
IAM_OPEN_REGISTRATION=false

# 分布式限流：每个窗口内每个身份（IP/邮箱）允许的次数，窗口长度 IAM_RATE_LIMIT_WINDOW（秒）。
IAM_LOGIN_RATE_LIMIT=10
IAM_REGISTER_RATE_LIMIT=5
IAM_RESEND_RATE_LIMIT=3
IAM_RESET_RATE_LIMIT=5
IAM_RATE_LIMIT_WINDOW=600

# 引导首个管理员（可重复执行；已存在管理员时为空操作）。
IAM_BOOTSTRAP_ADMIN_EMAIL=
IAM_BOOTSTRAP_ADMIN_PASSWORD=

# ============================================================
# LiteLLM Proxy、Run Key 与成本预算
# ============================================================

# LiteLLM Master Key，只供 API 控制面创建、续期和封禁 Run Key。
# LiteLLM 要求以 sk- 开头。示例值仅适用于本地开发，生产环境必须替换为强随机值。
LITELLM_MASTER_KEY=sk-change-me

# 受限 Service Key，用于离线评估和维护任务。不要填写 Master Key。
# 先启动 LiteLLM，再用管理脚本铸造只允许调用必要模型组、带周期预算的
# Virtual Key，并把打印的 key 填到下方：
#   uv run python -m open_deep_research.models.mint_service_key
LITELLM_SERVICE_KEY=

# Service Key 的预算上限（微美元）与重置周期；仅铸造脚本读取。
LITELLM_SERVICE_BUDGET_MICRO_USD=20000000
LITELLM_SERVICE_BUDGET_DURATION=30d

# 应用访问 LiteLLM 的 OpenAI 兼容地址。本机直接运行使用 localhost；
# Docker Compose 会自动覆盖为 http://litellm-proxy:4000/v1。
LITELLM_BASE_URL=http://localhost:4000/v1

# 仅用于本地 Compose 的 LiteLLM PostgreSQL 密码；生产环境使用独立托管数据库强密码。
LITELLM_DATABASE_PASSWORD=litellm-local-only

# =============================================================================
# Local Documents + Hybrid Research
# =============================================================================

# 研究来源模式是每次 POST /runs 请求中的 source_selection.mode，不是全局环境变量。
# 未传 source_selection 时保持兼容并默认为 web；可选值：web/documents/hybrid/specific。

# Compose 的应用数据库密码。app-db 同时承载 IAM 与 pgvector 文档索引，
# 与 LiteLLM 自身数据库严格分离。
APP_DATABASE_PASSWORD=insightforge-local-only

# 非 Compose 部署默认关闭，依赖不健康时 Web Research 仍可单独运行。
DOCUMENT_RESEARCH_ENABLED=false

# 文档 DSN；未填写时回退 IAM_DATABASE_URL。
DOCUMENT_DATABASE_URL=postgresql://insightforge:insightforge-local-only@localhost:5432/insightforge
DOCUMENT_STORAGE_DIR=.documents
DOCUMENT_MAX_FILE_BYTES=52428800
DOCUMENT_MAX_COUNT_PER_USER=500
DOCUMENT_MAX_BYTES_PER_USER=5368709120
DOCUMENT_EMBEDDING_MODEL=if-embedding-v1
DOCUMENT_EMBEDDING_DIMENSIONS=1536
DOCUMENT_EMBEDDING_BATCH_SIZE=64
# 中文/标题 pg_trgm 候选通道的最低 word_similarity 分数（0-1）。
DOCUMENT_TRIGRAM_MIN_SCORE=0.08
DOCUMENT_WORKER_POLL_SECONDS=2
DOCUMENT_WORKER_HEARTBEAT_SECONDS=30

# 自部署 Docling Serve 解析服务（知识库 KB-06）；留空表示未部署、走现有解析。
# 仅内网可达，需 API Key；模型缓存在容器卷中持久化，版本固定不用 latest。
# DOCLING_SERVE_URL=http://docling-serve:5001
# DOCLING_SERVE_API_KEY=
# DOCLING_TIMEOUT_SECONDS=600
# DOCLING_MAX_CONCURRENT_TASKS=2
# DOCLING_POLL_SECONDS=2
# DOCLING_OCR_LANG=ch_sim,en
# Optional LLM metadata suggestions; empty uses deterministic extraction only.
DOCUMENT_METADATA_SUGGESTION_MODEL=if-summarization-v1
DOCUMENT_SOFFICE_PATH=soffice
DOCUMENT_OFFICE_PREVIEW_TIMEOUT_SECONDS=180
DOCUMENT_TABLE_ROW_GROUP_SIZE=40
# Standalone knowledge calls use LITELLM_SERVICE_KEY. Grant that key these
# routes and DOCUMENT_EMBEDDING_MODEL through the gateway's model allowlist.
KNOWLEDGE_RERANK_MODEL=if-web-rerank-v1
KNOWLEDGE_ANSWER_MODEL=if-summarization-v1
KNOWLEDGE_MODEL_CALLS_PER_USER_DAY=0
DOCUMENT_WORKER_LEASE_SECONDS=300
DOCUMENT_WORKER_MAX_ATTEMPTS=3
DOCUMENT_WORKER_METRICS_PORT=9109

DOCUMENT_OCR_ENABLED=false

# local: Worker 内置 PaddleOCR；remote: 调用下方 HTTP OCR 服务（JSON base64 协议）。
DOCUMENT_OCR_MODE=local
DOCUMENT_OCR_URL=http://172.22.208.30:8080/ocr
DOCUMENT_OCR_API_KEY=
DOCUMENT_OCR_TIMEOUT_SECONDS=120

# PaddleOCR 服务 fileType：0=image，1=服务端支持的其他文件类型。
# 远程服务需能从 document-worker 容器访问；请求体为 JSON，file 为 base64 字符串。
DOCUMENT_OCR_FILE_TYPE=0
DOCUMENT_OCR_DPI=300

# 预先在 LiteLLM 中创建的 Run Team ID。每个研究 Run 的短期 Key都归属该 Team。
LITELLM_RUN_TEAM_ID=insightforge-runs

# MODEL_BACKEND=litellm 时必填。生成一个 32 字节随机值并进行 URL-safe Base64编码：
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 生产环境不得使用示例固定值，也不得在部署后随意更换，否则旧 Run Key无法解密。
LITELLM_RUN_KEY_ENCRYPTION_KEY=

# 管理员控制的单 Run 成本预算，单位为 micro-USD（1 美元 = 1,000,000 micro-USD）。
# 以下本地示例表示：默认每个 Run 最多 5 美元，管理员硬上限 20 美元。
LITELLM_RUN_BUDGET_DEFAULT_MICRO_USD=5000000
LITELLM_RUN_BUDGET_MAX_MICRO_USD=20000000

# Run Key有效期，单位为秒；获取 Lease或恢复 Run时会自动续期。
LITELLM_RUN_KEY_TTL_SECONDS=86400

# 可选：按 IAM 角色的 Team 级预算（Tier 1，全部 env 驱动）。配置后 Run Key
# 按创建者最高特权角色（admin > developer > researcher）挂入 if-team-{role}
# Team，由 LiteLLM 对该角色全部 Key 聚合强制预算并按周期重置。未配置任何
# BUDGET_MICRO_USD 时保持全局 Run Team（现有行为）。注意：修改角色预算会
# 重置该角色的账期。周期格式：<n><s|m|h|d|mo>。
# LITELLM_TEAM_ADMIN_BUDGET_MICRO_USD=100000000
# LITELLM_TEAM_DEVELOPER_BUDGET_MICRO_USD=50000000
# LITELLM_TEAM_RESEARCHER_BUDGET_MICRO_USD=20000000
# LITELLM_TEAM_DEFAULT_BUDGET_MICRO_USD=
# LITELLM_TEAM_DEFAULT_BUDGET_DURATION=30d
# LITELLM_TEAM_DEVELOPER_RPM_LIMIT=600
# LITELLM_TEAM_DEVELOPER_TPM_LIMIT=2000000

# Key与路由策略修订号。策略含义变化时递增，不要原地改写旧版本语义。
LITELLM_POLICY_REVISION=v1

# 新 Run 使用的模型 Backend。旧 Run仍按 Manifest 中冻结的值恢复。
MODEL_BACKEND=litellm

# 可选：终稿长文写作经网关流式生成（Phase 1）。开启后首包超时（默认 15s）
# 与空闲超时替代整段 180s 超时；部署不支持流式或首包超时会自动降级回
# 非流式路径。不影响工具调用与结构化输出，不进 Run 冻结契约。
FINAL_REPORT_STREAM_ENABLED=false

# Docker Compose 的可选路由别名覆盖。通常保持注释，使用 docker-compose.yaml 的版本化默认值。
# 这些变量故意不复用旧版模型变量，避免旧 `.env` 中的 provider:model 值污染 LiteLLM Run。
# LITELLM_SUPERVISOR_MODEL=if-supervisor-v1
# LITELLM_RESEARCH_MODEL=if-research-v1
# LITELLM_SUMMARIZATION_MODEL=if-summarization-v1
# LITELLM_MESSAGE_SUMMARY_MODEL=if-message-summary-v1
# LITELLM_WEB_RERANK_MODEL=if-web-rerank-v1
# LITELLM_WEB_EVIDENCE_MODEL=if-web-evidence-v1
# LITELLM_COMPRESSION_MODEL=if-compression-v1
# LITELLM_FINAL_REPORT_MODEL=if-final-report-v1
# LITELLM_QUALITY_EVALUATION_MODEL=if-quality-v1
# LITELLM_REPORT_REVIEW_MODEL=if-report-review-v1
# LITELLM_EVALUATION_MODEL=if-evaluation-v1

# ============================================================
# Legacy 模型接入兼容项
# ============================================================
# 仅当 MODEL_BACKEND=legacy 且仍需创建或恢复旧式 Run时取消注释。
# LiteLLM Run不会读取这些参数；新部署不要填写角色级 Provider Key或 Base URL。
# GET_API_KEYS_FROM_CONFIG=false
# QUALITY_EVALUATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QUALITY_EVALUATION_API_KEY=
# EVALUATION_BASE_URL=
# EVALUATION_API_KEY=
# MODEL_FALLBACKS={"researcher":["anthropic:claude-sonnet-4-5"]}
# MODEL_TRANSPORT_MAX_ATTEMPTS=3
# MODEL_CALL_TIMEOUT_SECONDS=180
# MODEL_CIRCUIT_BREAKER_ENABLED=true
# MODEL_CIRCUIT_FAILURE_THRESHOLD=5
# MODEL_CIRCUIT_FAILURE_WINDOW_SECONDS=300
# MODEL_CIRCUIT_OPEN_COOLDOWN_SECONDS=60
# MODEL_CIRCUIT_MAX_COOLDOWN_SECONDS=600
# MODEL_CIRCUIT_SLOW_RATIO_THRESHOLD=0.5
# MODEL_CIRCUIT_SLOW_MIN_SAMPLES=4
# MODEL_FIRST_PACKET_PROBE=shadow
# MODEL_FIRST_PACKET_TIMEOUT_SECONDS=15
# MODEL_SLOW_FIRST_PACKET_THRESHOLD_SECONDS=8
# MODEL_COSTS_PER_MILLION={"openai:gpt-4.1":{"input":2.0,"output":8.0,"cached_input":0.5}}
# LANGFUSE_LANGCHAIN_CALLBACK_ENABLED=false

# 将 Docker 控制网络与 Docling 所在的局域网网段隔离，避免路由冲突。
SANDBOX_CONTROL_SUBNET=172.22.0.0/24

# 知识库后台任务、资料归档与 S3 灾难恢复
# 以下配置供 knowledge-worker 和 knowledge-backup 使用；备份服务需显式启用 backup profile。
# 示例文件只保留占位值；真实地址、访问密钥和加密密码填写在不纳入版本控制的 .env 中。

# 知识库任务队列轮询间隔，单位：秒。处理事实候选提取、资料导入与导出。
KNOWLEDGE_WORKER_POLL_SECONDS=5

# 导出归档和待导入上传文件的保留时间，单位：小时；过期文件会清理，需重新提交。
KNOWLEDGE_EXPORT_TTL_HOURS=24

# 导入归档大小上限，单位：字节；同时限制上传文件大小与 ZIP 解压后总大小。默认 10 GiB。
# 经过代理部署时，代理的请求体大小限制也应与此值匹配，并预留 multipart 封装空间。
KNOWLEDGE_IMPORT_MAX_BYTES=10737418240

# 周期备份间隔，单位：小时；仅 knowledge-backup 的 loop 模式读取。默认每天一次。
KNOWLEDGE_BACKUP_INTERVAL_HOURS=24

# 每日备份保留数量，默认保留 30 个有备份的日期；loop 模式会执行保留策略并清理过期快照。
# 仓库没有每日成功备份时，此值不代表一定具备最近连续 30 天的恢复点。
KNOWLEDGE_BACKUP_KEEP_DAILY=30

# Restic 仓库地址：s3:http[s]://<S3 接口主机>:<端口>/<Bucket 名称>[/仓库目录前缀]
# 支持 RustFS 等 S3 兼容存储；Bucket 应提前创建，并授予下面访问密钥所需的读写和列举权限。
# RustFS 示例端口映射：9010 为 S3 接口，9011 为 Web 控制台；以实际部署映射为准。
# 正确示例：s3:http://rustfs.example.internal:9010/insight-forge
# 带独立目录前缀的示例：s3:http://rustfs.example.internal:9010/insight-forge/knowledge-backups
# 不要填写控制台网址，也不要包含 /rustfs/console/browser/ 等页面路径。
# http 仅适用于可信内网；使用 https 时应配置服务端证书及客户端信任链。
RESTIC_REPOSITORY=

# Restic 仓库加密密码，与 RustFS 登录密码、S3 Secret Key 是不同概念。
# 首次初始化仓库时设置；恢复和后续备份必须使用同一仓库密码。
# 请使用独立密码并另行安全保管；仅有 S3 文件和访问密钥无法替代此密码进行解密。
RESTIC_PASSWORD=

# RustFS 签发的 S3 Access Key ID（访问密钥标识）；不能留空。
AWS_ACCESS_KEY_ID=

# 与 Access Key ID 配对的 Secret Access Key（访问密钥），不要提交到示例文件或代码仓库。
AWS_SECRET_ACCESS_KEY=

# S3 签名使用的区域；需匹配 RustFS 服务端配置，未自定义区域时通常使用 us-east-1。
AWS_DEFAULT_REGION=us-east-1

# 灾备恢复演练的目标 PostgreSQL 连接串；仅 restore 命令需要，常规备份可留空。
# 必须先创建独立空数据库；程序拒绝恢复到源数据库或已包含业务表的数据库。
# 示例：postgresql://restore_user:替换为密码@app-db:5432/insightforge_restore_check
# 连接串内密码如含 @、:、/ 等特殊字符，需要进行 URL 编码；不要在示例文件填写真实密码。
KNOWLEDGE_RESTORE_DATABASE_URL=

# 首次使用：填写 .env，确认 Bucket 和权限，再显式执行仓库初始化（已有仓库不要重复初始化）：
# docker compose --profile backup run --rm knowledge-backup init
# 手动备份并检查仓库：docker compose --profile backup run --rm knowledge-backup backup
# 周期备份：docker compose --profile backup up -d knowledge-backup
# 完整读取并校验仓库数据：docker compose --profile backup run --rm knowledge-backup check
# 恢复演练：填写上面的独立目标数据库，使用尚不存在的恢复目录：
# docker compose --profile backup run --rm knowledge-backup restore --snapshot latest --destination /restore/drill-001
# 恢复文件留存在 knowledge-backup-restore 卷中；恢复成功后仍需按业务场景检查文档与引用。

# RocketMQ 团队协调：ENABLE_ASYNC_RESEARCH=true 时必填。
# 协调状态 PostgreSQL DSN，格式 postgresql://用户名:密码@主机:5432/数据库；
# 默认无值。Docker Compose 自动指向 app-db，迁移使用 alembic upgrade head。
COORDINATION_DATABASE_URL=
# RocketMQ 5.x Proxy 的 gRPC 服务接口，格式 主机:端口；默认无值，常见服务端口 8081（不是管理控制台）。
ROCKETMQ_ENDPOINT=
# 部署独占的 Topic/消费组前缀，默认 insightforge；不同数据库不可共用该前缀。
# 需预建 <前缀>_coordination_events_v1 和 <前缀>_coordination_control_v1，消息类型 TRANSACTION。
ROCKETMQ_TOPIC_PREFIX=insightforge

# Proxy TLS 开关，默认 false；Proxy 启用 TLS 时设置 true。
ROCKETMQ_TLS=false

# Broker/Proxy 开启鉴权时必填，默认留空；填写实际凭据到本地 .env，不提交版本库。
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=

# =============================================================================
# AgentScope 运行时（迁移期新框架服务组件，详见 docs/agentscope-migration/）
# =============================================================================

# 框架服务存储连接串（postgresql+asyncpg://用户:密码@主机:5432/库名）。
# 留空时进入演示模式：使用本地 SQLite 文件（.runs/agentscope-runtime.db），
# 仅适合本地体验，不支持团队/知识库完整模式。
# AS_DATABASE_URL=

# 框架表所在 PostgreSQL schema 名。框架与业务表同库时必须使用独立 schema
# （默认 agentscope_runtime）；业务表（含同名 knowledge_bases）不受影响。
AS_DATABASE_SCHEMA=agentscope_runtime

# 是否允许服务启动时自动建表（create_all）。仅开发/演示环境设为 true；
# 生产必须为 false（默认），schema 变更走显式迁移命令，禁止隐式迁移。
AS_STORAGE_AUTO_CREATE=false

# 持久总线（队列/日志/锁/注册表）的表名前缀，避免与业务表同名。一般不改。
AS_BUS_TABLE_PREFIX=as_bus_

# RocketMQ 广播（完整 PG 模式可启用；留空时仅进程内通知）。
# 填写 Proxy 的 gRPC 服务接口，格式 主机:端口；不是 NameServer 的 9876 或管理控制台。
# 本项目指定服务器的 NameServer 为 172.22.121.109:9876，对应已验证 Proxy 为 172.22.121.109:8081。
AS_ROCKETMQ_ENDPOINT=
# 默认 insightforge_as；须预建 <前缀>_broadcast_wake_v1（NORMAL 类型），不同业务库独占前缀。
AS_ROCKETMQ_TOPIC_PREFIX=insightforge_as
# 启用远程广播时必填：每个并行运行实例使用独立、预建的消费组；重启可复用。
# 不同实例共用消费组会负载均衡，无法确保所有实例收到广播。示例：insightforge_as_api_01。
AS_ROCKETMQ_GROUP=
# Proxy 启用鉴权时必填，默认空；真实值仅保存在本地配置中。
AS_ROCKETMQ_ACCESS_KEY=
AS_ROCKETMQ_SECRET_KEY=
# Proxy 是否启用 TLS，默认 false；按服务器配置填写。
AS_ROCKETMQ_TLS=false
# 停止接收后等待在途请求/命令的时间，单位秒，默认 30；超时取消后仍等待 finally 保存完成。
AS_DRAIN_TIMEOUT_SECONDS=30

# 原生生产研究资源：默认 host；gateway 模式需 RESEARCH_ENGINE=native、AS_DATABASE_URL、
# LiteLLM 控制凭据及 Sandbox Gateway。仅影响显式启用的原生入口。
RESEARCH_ENGINE=legacy
AS_NATIVE_RESOURCES=host
# 可信团队控制进程镜像（不是执行用户 shell 的沙箱镜像）；开启异步研究时必填。
AS_TEAM_WORKER_IMAGE=insightforge-api:local
# Controller 可读取的专用环境文件绝对路径；包含 AS_DATABASE_URL、远程 MQ、IAM 与根签名配置。
# 不应使用沙箱环境文件，也不要将此文件提交到 Git；默认留空并拒绝启动团队容器。
AS_TEAM_WORKER_ENV_FILE=
# 现有 Docker 网络名称，默认留空使用 Docker 默认网络；需能访问 API/Gateway/PG 和远程 MQ。
AS_TEAM_WORKER_NETWORK=
# Docker --mount 参数的 JSON 数组，默认 []；生产须共享 RUNS_DIR 工件目录与策略文件。
# 示例：["type=bind,source=/srv/insightforge/runs,target=/app/.runs"]
AS_TEAM_WORKER_MOUNTS=[]

# Controller 使用 Docker SDK 启动可信团队；挂载数组格式为 target/source/type/read_only。
# 默认空数组；生产必须共享 API 的 RUNS_DIR 卷，资料检索另需资料卷与数据库配置。
AS_TEAM_CONTROLLER_MOUNTS=[]
